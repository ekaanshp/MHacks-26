# The complete demo runs offline by default. No account creation is needed.
LASTLY_OFFLINE=true
# Runtime files (including imported private inboxes) are ignored by git.
# LASTLY_DATA_DIR=/absolute/path/to/local-estate

# Extraction, letters and questions. Change LASTLY_OFFLINE to false to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheap first pass that decides which senders hold accounts.
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5
# Only needed when the key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Real Takeout input stays local unless this is explicitly enabled.
ALLOW_PRIVATE_CLOUD=false

# Neon PostgreSQL: certificate and hostname verification are enforced by code.
# Paste the Neon connection string as-is; verify-full TLS is always applied.
DATABASE_URL=
# Loopback Postgres development only; never enables plaintext remote connections.
LASTLY_ALLOW_INSECURE_DB=false

# ElevenLabs agent connected to an imported Twilio phone number.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Twilio credentials are used in the ElevenLabs dashboard to import the number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FAMILY_EXECUTOR=Daniel
# Explicit authorized E.164 recipients, comma-separated. Empty blocks all calls.
LASTLY_ALLOWED_CALL_NUMBERS=
# Durable budget per UTC day (1..100); default10. Also 3 requests/minute.
LASTLY_CALL_DAILY_LIMIT=10

# Fetch.ai is a separate optional process. Generate one seed, then keep it fixed.
AGENT_SEED=
AGENT_MAILBOX=true
AGENT_PORT=8001
LASTLY_API_BASE_URL=http://127.0.0.1:8000
# Security: required for private data and live AI/voice. Random32+ characters.
LASTLY_ACCESS_TOKEN=
# Mandatory for Fetch bridge, distinct random32+ characters; read/question only.
LASTLY_AGENT_TOKEN=
# Private local data uses AES-256-GCM. Supply a base64url32-byte key separately.
# Keep this key outside backups and source control. Losing it loses the data.
LASTLY_DATA_KEY=
# Production is fail-closed: requires access code, encryption and HTTPS.
LASTLY_PRODUCTION=false
# Defaults to loopback hostnames. Production needs exact hosts and HTTPS origins.
# LASTLY_ALLOWED_HOSTS=lastly.example.com
# LASTLY_ALLOWED_ORIGINS=https://lastly.example.com
# Optional comma separated allowed Fetch.ai sender addresses.
FETCH_ALLOWED_SENDERS=

# Agent-to-agent claims (optional). insurer_agent.py simulates an insurer's claims agent.
# Generate a long random CLAIMS_AGENT_SEED; `python manage.py integrations` prints both addresses.
CLAIMS_AGENT_SEED=
CLAIMS_AGENT_ADDRESS=
CLAIMS_AGENT_PORT=8002
# Same-laptop delivery; leave empty to resolve agents through the Almanac instead.
CLAIMS_AGENT_ENDPOINT=http://127.0.0.1:8002/submit
LASTLY_AGENT_ADDRESS=
LASTLY_AGENT_ENDPOINT=http://127.0.0.1:8001/submit
# Subscription and notification conversations reuse insurer_agent.py by default.
# Optional separate company agent; falls back to CLAIMS_AGENT_ADDRESS/ENDPOINT.
COMPANY_AGENT_ADDRESS=
COMPANY_AGENT_ENDPOINT=
